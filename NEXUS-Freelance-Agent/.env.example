# Copy to .env (never commit .env). Every key can also be entered in the app: Settings → API keys (stored encrypted).
ANTHROPIC_API_KEY=
# Optional alternative/extra providers (OpenAI-compatible: OpenAI, DeepSeek, Gemini, Ollama). Configure base URL + model in Settings → llm.
OPENAI_API_KEY=
# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
# Google Cloud OAuth client (type "Web application"), redirect URI: http://127.0.0.1:8765/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional: Brave Search API key — lets the Platform Discovery agent find NEW platforms on the web
BRAVE_API_KEY=
# Freelancer.com access token of your own account → automatic bids (Smart/Full mode)
FREELANCER_TOKEN=
# Optional: encryption key for the vault (otherwise data/master.key is generated). Keep it safe: without it the vault can't be read.
NEXUS_MASTER_KEY=
# Server use only: required when listening on a non-local interface
NEXUS_ACCESS_TOKEN=
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8765
